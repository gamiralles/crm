# API local / servidor. Copiar a .env local; nunca completar con secretos y subirlo a Git.
NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:5173
MONGODB_URI=
SESSION_SECRET=
SESSION_COOKIE_NAME=crm.sid
SESSION_SAME_SITE=lax
INITIAL_SETUP_KEY=
TRUST_PROXY=0
LOG_LEVEL=info
SCHEDULER_SECRET=
# Vercel Cron usa CRON_SECRET y lo envía automáticamente como Authorization: Bearer.
CRON_SECRET=

# Opcional: Web Push (configurar ambas claves juntas).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contacto@example.invalid

# Opcional: correo por SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Opcional: Telegram (configurar los tres valores juntos).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Opcional: Outlook/Microsoft Graph (configurar los cuatro valores juntos).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=
MICROSOFT_TOKEN_ENCRYPTION_KEY=
